<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="colorPrimary">@color/xenia_green</item>
        <item name="colorPrimaryDark">@color/xenia_green_dark</item>
        <item name="colorAccent">@color/xenia_green</item>
        <item name="colorOnPrimary">@color/xenia_on_background</item>
        <item name="colorSurface">@color/xenia_surface</item>
        <item name="colorOnSurface">@color/xenia_on_background</item>
        <item name="colorOnBackground">@color/xenia_on_background</item>
        <item name="android:windowBackground">@color/xenia_background</item>
        <item name="android:textColorPrimary">@color/xenia_on_background</item>
        <item name="android:textColorSecondary">@color/xenia_on_background_secondary</item>
    </style>

    <style name="SettingsSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/xenia_green_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
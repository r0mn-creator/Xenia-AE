<?xml version="1.0" encoding="utf-8"?>
<!-- Dolphin-style in-game pause menu. Uses plain @color/ references (not
     ?attr/ theme attributes) because EmulatorActivity's manifest theme is a
     bare platform theme, not an AppCompat/MaterialComponents theme. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="260dp"
    android:orientation="vertical"
    android:background="@color/xenia_surface"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/pause_menu_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/xenia_on_background"
        android:textSize="18sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="@color/xenia_on_background_secondary"
        android:alpha="0.25" />

    <TextView
        android:id="@+id/row_resume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/resume_game"
        android:textColor="@color/xenia_on_background"
        android:textSize="16sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/row_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/xenia_on_background"
        android:textSize="16sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/xenia_on_background_secondary"
        android:alpha="0.25" />

    <TextView
        android:id="@+id/row_exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/exit_game"
        android:textColor="@color/xenia_danger"
        android:textSize="16sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>

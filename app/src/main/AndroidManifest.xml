<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--  触摸屏功能声明为非必需  -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>

    <application
        android:appCategory="game"
        android:networkSecurityConfig="@xml/network_security_config"
        android:name="org.xeniaae.Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="true"
        android:allowNativeHeapPointerTagging="false"
        tools:targetApi="31" >






        <activity android:name="org.xeniaae.MainActivity"

            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="layoutDirection|locale|orientation|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="org.xeniaae.EmulatorActivity"

            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:process=":emu"
            >
            <intent-filter>
                <action android:name="org.xeniaae.intent.action.EMULATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!--
                Third-party front-end entry point (Daijishou, ES-DE, Beacon...).

                This filter used to declare ACTION_VIEW with NO <data> element.
                An intent-filter without <data> only matches intents that carry
                no URI and no MIME type, so it could never match a real launch -
                AEX simply did not appear in any front-end's emulator list, and
                an explicit launch fell through to "Can't open game" because
                nothing read getData() either. Both halves are fixed together;
                see docs/INTENT_API.md.

                Kept permissive on purpose. Front-ends differ: SAF-based ones
                send content:// with application/octet-stream or */*, while
                path-based ones send file:// often with no type at all. A filter
                that only accepted one shape would silently exclude the other,
                which is exactly the failure being fixed here.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!--
                Untyped content:// launches.

                A filter that declares a mimeType only matches intents that
                CARRY a type, so the filter above misses a front-end that sends
                a bare content:// URI with no type - and several do. This filter
                declares a scheme and no type, which is the complement: it
                matches a URI with no type and nothing else. Verified with
                `cmd package query-activities`: without this, an untyped
                content:// VIEW resolved to two unrelated apps and not to us.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
            </intent-filter>
            <!-- Untyped file:// launches, matched on extension instead. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.iso" />
                <data android:pathPattern=".*\\.ISO" />
                <data android:pathPattern=".*\\.xex" />
                <data android:pathPattern=".*\\.XEX" />
                <data android:pathPattern=".*\\.zar" />
                <data android:pathPattern=".*\\.ZAR" />
            </intent-filter>
        </activity>
        <activity android:name="org.xeniaae.EmulatorSettings"
            android:exported="false"
            android:label="@string/settings"/>
        <activity android:name="org.xeniaae.DriverSettingsActivity"
            android:exported="false"
            android:label="@string/settings_custom_driver"/>
        <!-- CANARY-AE DEBUG MODULE - delete this entry for mainline Xenia AE -->
        <activity android:name="org.xeniaae.PatchesActivity"
            android:exported="false"
            android:label="@string/patches_title"/>
        <activity android:name="org.xeniaae.SettingsCategoryActivity"
            android:exported="false"/>
        <activity android:name="org.xeniaae.DebugSettingsActivity"
            android:exported="false"
            android:label="Debug"/>
        <activity android:name="org.xeniaae.KeyMapActivity"
            android:exported="false"
            android:label="@string/key_mappers"/>
        <activity android:name="org.xeniaae.VirtualControlEdit"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"/>
        <activity android:name="org.xeniaae.AboutActivity" android:exported="false" android:label="@string/about"> </activity>
        <provider
            android:name="org.xeniaae.DocumentsProvider"
            android:authorities="${applicationId}.DocumentsProvider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

    </application>

</manifest>
#version 450
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer InBuf {
    float inputs[];
};
layout(std430, binding = 1) writeonly buffer OutBuf {
    // Per input: exp2, log2, nclamp(-256,255), convertftos-of-clamped
    float outputs[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    float x = inputs[i];
    uint base = i * 4u;
    outputs[base + 0u] = exp2(x);
    outputs[base + 1u] = log2(abs(x) + 1e-30);
    float a0f = clamp(floor(x + 0.5), -256.0, 255.0);
    outputs[base + 2u] = a0f;
    outputs[base + 3u] = float(int(a0f));
}
